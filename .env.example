# Solana / QuickNode (devnet)
# When both are set, memos go to real Solana Devnet. Otherwise seals use cluster:"stub".
QUICKNODE_SOLANA_RPC=
# Base58 secret key OR JSON byte array from solana-keygen
FEESEAL_SIGNER_SECRET=

# Vision extraction (menu photo publish + diner scans)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional absolute origin for server-side public menu fetches
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Public
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_EXPLORER_BASE=https://explorer.solana.com
