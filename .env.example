# Local site (Diego — port 8080)
PORT=8080
NEXT_PUBLIC_BASE_URL=http://localhost:8080

# Solana / QuickNode (devnet) — optional; without these, seals use cluster:"stub"
QUICKNODE_SOLANA_RPC=
# Base58 secret key OR JSON byte array from solana-keygen
FEESEAL_SIGNER_SECRET=

# Vision extraction — optional; without this, extract falls back to fixtures
OPENAI_API_KEY=

# Public
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_EXPLORER_BASE=https://explorer.solana.com
